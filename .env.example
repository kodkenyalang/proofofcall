# Cluster: devnet (default) or mainnet. Aurora top-ups only work on mainnet.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional: dedicated RPC (public endpoints are rate-limited)
# NEXT_PUBLIC_SOLANA_RPC_URL=
# SOLANA_RPC_URL=
# Adds a 5-minute horizon for live demos
NEXT_PUBLIC_DEMO_HORIZONS=true

# x402 facilitator. Defaults to https://x402.org/facilitator on devnet; REQUIRED on mainnet
# (e.g. a PayAI, Dexter or Coinbase CDP facilitator URL).
# X402_FACILITATOR_URL=

# Aurora Intents API key (free, from https://studio.aurora.dev). Mainnet only.
# AURORA_API_KEY=
